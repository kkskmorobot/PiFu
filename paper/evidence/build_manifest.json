  "equations": [
    {
      "id": "2-1",
      "latex": "\\mathrm{IoU}=\\frac{TP}{TP+FP+FN}",
      "lines": 1
    },
    {
      "id": "2-2",
      "latex": "\\mathrm{Dice}=\\frac{2TP}{2TP+FP+FN}=\\frac{2\\mathrm{IoU}}{1+\\mathrm{IoU}}",
      "lines": 1
    },
    {
      "id": "2-3",
      "latex": "F_{1,k}=\\frac{2TP_k}{2TP_k+FP_k+FN_k},\\qquad F_{1,\\mathrm{macro}}=\\frac{1}{8}\\sum_{k=1}^{8}F_{1,k}",
      "lines": 2
    },
    {
      "id": "2-4",
      "latex": "\\bar{p}_{g,k}=\\frac{1}{n_g}\\sum_{i\\in g}p_{i,k},\\qquad \\hat{y}_g=\\arg\\max_k\\bar{p}_{g,k}",
      "lines": 2
    },
    {
      "id": "2-5",
      "latex": "J=\\sqrt{\\mathrm{IoU}\\times F_{1,\\mathrm{group}}}",
      "lines": 1
    },
    {
      "id": "2-6",
      "latex": "\\bar{x}=\\frac{1}{3}\\sum_{s=1}^{3}x_s,\\qquad s_x=\\sqrt{\\frac{1}{2}\\sum_{s=1}^{3}(x_s-\\bar{x})^2}",
      "lines": 2
    },
    {
      "id": "3-1",
      "latex": "(F_3,F_4)=\\Phi(X),\\quad S=h_s(F_3),\\quad S^{a}=h_a(F_4)",
      "lines": 1
    },
    {
      "id": "3-2",
      "latex": "A_i=\\sigma(\\operatorname{sg}(S_i)),\\quad A_i^{(s)}=\\operatorname{clip}(\\operatorname{Resize}(A_i,H_s,W_s),0,1)",
      "lines": 2
    },
    {
      "id": "3-3",
      "latex": "g_i^{(s)}=\\frac{1}{H_sW_s}\\sum_{u=1}^{H_s}\\sum_{v=1}^{W_s}F_i^{(s)}(u,v)",
      "lines": 1
    },
    {
      "id": "3-4",
      "latex": "\\widetilde{l}_i^{(s)}=\\frac{\\sum_{u,v}A_i^{(s)}(u,v)F_i^{(s)}(u,v)}{\\max(\\sum_{u,v}A_i^{(s)}(u,v),\\varepsilon)}",
      "lines": 1
    },
    {
      "id": "3-5",
      "latex": "m_i^{(s)}=\\frac{\\sum_{u,v}A_i^{(s)}(u,v)}{H_sW_s},\\quad l_i^{(s)}=r_i^{(s)}g_i^{(s)}+(1-r_i^{(s)})\\widetilde{l}_i^{(s)}",
      "lines": 2
    },
    {
      "id": "3-6",
      "latex": "G_i=[P_3g_i^{(3)}+b_3;P_4g_i^{(4)}+b_4],\\quad L_i=[P_3l_i^{(3)}+b_3;P_4l_i^{(4)}+b_4]",
      "lines": 2
    },
    {
      "id": "3-7",
      "latex": "q_i=W_2\\operatorname{SiLU}(W_1[G_i;L_i]+b_1)+b_2,\\quad (\\alpha_i,\\beta_i)=\\operatorname{Softmax}(q_i)",
      "lines": 2
    },
    {
      "id": "3-8",
      "latex": "f_i=\\alpha_iG_i+\\beta_iL_i,\\quad z_i=W_c\\operatorname{Dropout}_{0.20}(\\operatorname{SiLU}(W_ff_i+b_f))+b_c",
      "lines": 2
    },
    {
      "id": "3-9",
      "latex": "\\mathcal{R}_{bal}=\\left(\\frac{1}{n_c}\\sum_{i\\in\\mathcal{C}}(q_{i,L}-q_{i,G})\\right)^2",
      "lines": 1
    },
    {
      "id": "3-10",
      "latex": "\\mathcal{L}_{BCE}=\\frac{\\sum_{v\\in\\mathcal{V}}[-y_v\\log p_v-(1-y_v)\\log(1-p_v)]}{\\max(|\\mathcal{V}|,1)}",
      "lines": 1
    },
    {
      "id": "3-11",
      "latex": "\\mathcal{L}_{Dice}=1-\\frac{2\\sum_{v\\in\\mathcal{V}}p_vy_v+1}{\\sum_{v\\in\\mathcal{V}}(p_v+y_v)+1},\\quad \\mathcal{L}_{seg}=\\mathcal{L}_{BCE}+\\mathcal{L}_{Dice}+0.4\\mathcal{L}_{BCE}^{a}",
      "lines": 2
    },
    {
      "id": "3-12",
      "latex": "\\mathcal{L}_{cls}=-\\frac{1}{n_c}\\sum_{i\\in\\mathcal{C}}\\log\\frac{\\exp z_{i,y_i}}{\\sum_{k=1}^{8}\\exp z_{i,k}},\\quad \\mathcal{L}_{total}=B[\\mathcal{L}_{seg}+0.5(\\mathcal{L}_{cls}+0.01\\mathcal{R}_{bal})]",
      "lines": 2
    }
  ],
